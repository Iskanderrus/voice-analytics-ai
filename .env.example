# Copy to .env (make setup does this). Never commit .env.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_SECURE_COOKIES=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOG_FORMAT=json
LOG_LEVEL=INFO

API_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDIS_PORT=6379

S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
UPLOAD_MAX_BYTES=209715200
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_PENDING_TTL_SECONDS=86400
UPLOAD_MAINTENANCE_INTERVAL_SECONDS=300

PIPELINE_STAGE_LEASE_SECONDS=1800
PIPELINE_STALL_SECONDS=3600
PIPELINE_SWEEP_INTERVAL_SECONDS=300

# make offline-up forces local providers. For cloud mode set openai and provide the key.
STT_PROVIDER=whisper_local
STT_MODEL=base
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=
